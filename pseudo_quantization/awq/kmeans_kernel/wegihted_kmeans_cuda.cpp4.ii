# 36 "/root/cuda/include/thrust/system/cuda/detail/fill.h"
 namespace thrust {
namespace cuda_cub {

namespace __fill {


  template<class Iterator, class T>
  struct functor
  {
    Iterator it;
    T value;

    __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline))
    functor(Iterator it, T value)
        : it(it), value(value) {}

    template<class Size>
    __attribute__((device)) __inline__ __attribute__((always_inline)) void operator()(Size idx)
    {
      it[idx] = value;
    }
  };

}

template <class Derived, class OutputIterator, class Size, class T>
OutputIterator __attribute__((host)) __attribute__((device))
fill_n(execution_policy<Derived>& policy,
       OutputIterator first,
       Size count,
       const T& value)
{
  cuda_cub::parallel_for(policy,
                         __fill::functor<OutputIterator, T>(
                         first,
                         value),
                         count);

  cuda_cub::throw_on_error(
    cuda_cub::synchronize(policy)
  , "fill_n: failed to synchronize"
  );

  return first + count;
}

template <class Derived, class ForwardIterator, class T>
void __attribute__((host)) __attribute__((device))
fill(execution_policy<Derived>& policy,
     ForwardIterator first,
     ForwardIterator last,
     const T& value)
{
  cuda_cub::fill_n(policy, first, thrust::distance(first,last), value);
}


}
}
