    };

public:

    enum
    {

        BINS_TRACKED_PER_THREAD = ((((RADIX_DIGITS + BLOCK_THREADS - 1) / BLOCK_THREADS) > (1)) ? ((RADIX_DIGITS + BLOCK_THREADS - 1) / BLOCK_THREADS) : (1)),
