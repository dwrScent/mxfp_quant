inline std::vector<c10::optional<Variable>> to_optional(variable_list& output) {

  std::vector<c10::optional<Variable>> result;
  std::transform(
      output.begin(),
      output.end(),
      std::back_inserter(result),
      [](const Variable& var) { return var; });
  return result;
}

