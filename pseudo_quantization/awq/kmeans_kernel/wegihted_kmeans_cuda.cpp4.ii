        }

        if (tstate->gilstate_counter == 0) {

            if (!release) {
                pybind11_fail("scoped_acquire::dec_ref(): internal error!");
            }

            PyThreadState_Clear(tstate);
            if (active) {
                PyThreadState_DeleteCurrent();
            }
            PyThread_tss_set((detail::get_internals().tstate), nullptr);
            release = false;
        }
