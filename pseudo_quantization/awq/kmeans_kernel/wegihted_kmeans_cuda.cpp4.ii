  struct serial_set_intersection
  {

    template <class T, class CompareOp, int ITEMS_PER_THREAD>
    int __attribute__((device)) __inline__ __attribute__((always_inline))
    operator()(T * keys,
               int keys1_beg,
               int keys2_beg,
               int keys1_count,
               int keys2_count,
               T (&output)[ITEMS_PER_THREAD],
               int (&indices)[ITEMS_PER_THREAD],
               CompareOp compare_op)
    {
      int active_mask = 0;

      int aBegin = keys1_beg;
      int bBegin = keys2_beg;
      int aEnd = keys1_beg + keys1_count;
      int bEnd = keys2_beg + keys2_count;

      T aKey = keys[aBegin];
      T bKey = keys[bBegin];

