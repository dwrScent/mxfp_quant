  template <typename U>
  constexpr complex<T>& operator/=(const complex<U>& rhs)
      {


    T ar = real_;
    T ai = imag_;
    U br = rhs.real();
    U bi = rhs.imag();



    auto abs_br = std::abs(br);
    auto abs_bi = std::abs(bi);





    if (abs_br >= abs_bi) {
      if (abs_br == 0 && abs_bi == 0) {

        real_ = ar / abs_br;
        imag_ = ai / abs_bi;
      } else {
        auto rat = bi / br;
        auto scl = 1.0 / (br + bi * rat);
        real_ = (ar + ai * rat) * scl;
        imag_ = (ai - ar * rat) * scl;
      }
    } else {
      auto rat = br / bi;
      auto scl = 1.0 / (bi + br * rat);
      real_ = (ar * rat + ai) * scl;
      imag_ = (ai * rat - ar) * scl;
    }
    return *this;
  }


