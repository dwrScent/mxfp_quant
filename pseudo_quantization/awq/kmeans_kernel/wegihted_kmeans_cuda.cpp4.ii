template<typename DerivedPolicy,
         typename InputIterator,
         typename Predicate>
__attribute__((host)) __attribute__((device))
InputIterator find_if(execution_policy<DerivedPolicy> &,
                      InputIterator first,
                      InputIterator last,
                      Predicate pred)
{

  thrust::detail::wrapped_function<
    Predicate,
    bool
  > wrapped_pred(pred);

  while(first != last)
  {
    if (wrapped_pred(*first))
      return first;

    ++first;
  }


  return first;
}


}
}
}
