template <typename InputIteratorT>
__attribute__((device)) __inline__ __attribute__((always_inline)) typename std::iterator_traits<InputIteratorT>::value_type ThreadLoad(
    InputIteratorT itr,
    Int2Type<LOAD_DEFAULT> ,
    Int2Type<false> )
