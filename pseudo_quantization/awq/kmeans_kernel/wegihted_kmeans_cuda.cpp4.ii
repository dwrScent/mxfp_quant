  {
    cudaError_t status_;
    T value_;

  public:
    __attribute__((host)) __attribute__((device))
    cuda_optional() : status_(cudaSuccess) {}

    __attribute__((host)) __attribute__((device))
    cuda_optional(T v, cudaError_t status = cudaSuccess) : status_(status), value_(v) {}

    bool __attribute__((host)) __attribute__((device))
    isValid() const { return cudaSuccess == status_; }

    cudaError_t __attribute__((host)) __attribute__((device))
    status() const { return status_; }

    __attribute__((host)) __attribute__((device)) T const &
    value() const { return value_; }

    __attribute__((host)) __attribute__((device)) operator T const &() const { return value_; }
  };

