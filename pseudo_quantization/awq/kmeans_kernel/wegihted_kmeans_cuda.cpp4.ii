  OutputIterator exclusive_scan(thrust::execution_policy<ExecutionPolicy> &exec,
                                InputIterator first,
                                InputIterator last,
                                OutputIterator result,
                                T init)
{

  return thrust::exclusive_scan(exec, first, last, result, init, thrust::plus<>());
}


