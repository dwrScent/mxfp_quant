    template <typename _T, typename ScanOpT>
    __attribute__((device)) __inline__ __attribute__((always_inline)) void InclusiveScan(
        _T input,
        _T &inclusive_output,
        ScanOpT scan_op)
    {
        inclusive_output = input;


        int segment_first_lane = 0;


#pragma unroll
        for (int STEP = 0; STEP < STEPS; STEP++)
