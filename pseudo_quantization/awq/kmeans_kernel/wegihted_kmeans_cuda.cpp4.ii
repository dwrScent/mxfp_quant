__attribute__((host)) __attribute__((device)) inline c10::complex<T> log1p(const c10::complex<T>& z) {
# 305 "/root/miniconda3/envs/awq/lib/python3.10/site-packages/torch/include/c10/util/complex_math.h"
  T x = z.real();
  T y = z.imag();
  T zabs = std::abs(z);
  T theta = std::atan2(y, x + T(1));
  if (zabs < 0.5) {
    T r = x * (T(2) + x) + y * y;
    if (r == 0) {
      return {x, theta};
    }
    return {T(0.5) * std::log1p(r), theta};
  } else {
    T z0 = std::hypot(x + 1, y);
    return {std::log(z0), theta};
  }
}

