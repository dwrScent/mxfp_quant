namespace at {
namespace meta {

struct __attribute__((__visibility__("default"))) structured_all_dim : public at::impl::MetaBase {

                template <bool DIM = false>
                struct __attribute__((__visibility__("default"))) precompute_out {

                    precompute_out<true> set_dim(int64_t value) {
                        static_assert(DIM == false, "dim already set");
                        precompute_out<true> ret;
ret.dim = value;
return ret;
                    }

                    int64_t dim;
            };
    using meta_return_ty = precompute_out <true>;
