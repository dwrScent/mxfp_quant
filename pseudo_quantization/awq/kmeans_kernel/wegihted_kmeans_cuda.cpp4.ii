    class HeadTuple,
    class... TailTuples,
    std::enable_if_t<
        index<std::tuple_size<HeadTuple>::value, int> = 0> decltype(auto)
        extract_tuple_element_by_index(
            HeadTuple&& head_tuple,
            TailTuples&&... ) {

  return std::get<index>(std::forward<HeadTuple>(head_tuple));
