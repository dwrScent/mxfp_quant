inline Tensor _dropoutNd_helper(
    Tensor input,
    double p,
    bool training,
    bool inplace,
    const char* fn_name) {
  if (!(p >= 0. && p <= 1.)) { ::c10::detail::torchCheckFail( __func__, "/root/miniconda3/envs/awq/lib/python3.10/site-packages/torch/include/torch/csrc/api/include/torch/nn/functional/dropout.h", static_cast<uint32_t>(58), (::c10::detail::torchCheckMsgImpl( "Expected " "p >= 0. && p <= 1." " to be true, but got false.  " "(Could this error message be improved?  If so, " "please report an enhancement request to PyTorch.)", "dropout probability has to be between 0 and 1, but got ", p))); }


        ;

