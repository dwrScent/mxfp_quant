__attribute__((device)) float distance(float a, float b, float weight) {
    return fabs(a - b) * fabs(weight);
}

__attribute__((global)) void kmeans_kernel(float *input, float *x_feature, float *centroids, int *labels, float *output, float *initial_centroids, int N, int K, int max_iter, float* old_centroids, float* data_counts) {
    int tid = blockIdx.x * blockDim.x + threadIdx.x;
    old_centroids = old_centroids + tid * K;
    data_counts = data_counts + tid * K;



    float *data = input + tid * N;
    float *group_centroids;
    if (initial_centroids != nullptr) {

        group_centroids = initial_centroids + tid * K;
    }
    else{

        group_centroids = centroids + tid * K;
    }






    for(int k = 0; k < K; k++) {
        old_centroids[k] = 0.0f;
    }

    for(int iter = 0; iter < max_iter; iter++) {

        for(int i = 0; i < N; i++) {

            float min_dist = 3.40282346638528859811704183484516925e+38F;
            int min_index = -1;
            for(int k = 0; k < K; k++) {
                float dist = distance(data[i], group_centroids[k], x_feature[i]);
                if(dist < min_dist) {
                    min_dist = dist;
                    min_index = k;
                }
            }
            labels[tid * N + i] = min_index;
        }


        for(int k = 0; k < K; k++) {
            old_centroids[k] = group_centroids[k];
            group_centroids[k] = 0.0f;
            data_counts[k] = 0.0f;
        }

        for(int i = 0; i < N; i++) {
            group_centroids[labels[tid * N + i]] += fabs(x_feature[i]) * data[i];
            data_counts[labels[tid * N + i]] += fabs(x_feature[i]);
        }

        for(int k = 0; k < K; k++) {
            if(data_counts[k] != 0) {
                group_centroids[k] /= data_counts[k];
            }
        }


        float centroid_shift = 0.0f;
        for(int k = 0; k < K; k++) {
            centroid_shift += fabs(old_centroids[k] - group_centroids[k]);
        }

        if(centroid_shift < 1e-5f) {
            break;
        }
    }


    for(int i = 0; i < N; i++) {
        output[tid * N + i] = group_centroids[labels[tid * N + i]];
    }
    __syncthreads();
}


torch::Tensor weighted_kmeans_cuda(torch::Tensor input, torch::Tensor x_feature, torch::Tensor centroids, torch::Tensor labels, torch::Tensor output, torch::Tensor initial_centroids, int group_num, int nums_per_group, int num_cluster, int max_iter) {


    auto input_ptr = reinterpret_cast<float*>(input.data_ptr<float>());
    auto x_ptr = reinterpret_cast<float*>(x_feature.data_ptr<float>());
    auto centroids_ptr = reinterpret_cast<float*>(centroids.data_ptr<float>());
    auto labels_ptr = reinterpret_cast<int*>(labels.data_ptr<int>());
    auto initial_centroids_ptr = reinterpret_cast<float*>(initial_centroids.data_ptr<float>());
    auto output_ptr = reinterpret_cast<float*>(output.data_ptr<float>());




    float* data_counts;
    float* old_centroids;
    cudaMallocManaged(&old_centroids, group_num * num_cluster * sizeof(float));
    cudaMallocManaged(&data_counts, group_num * num_cluster * sizeof(float));


    int block_num = group_num > 128 ? group_num / 128 : 1;

    dim3 grid_dim(block_num, 1);
    dim3 block_dim(128, 1);



    int device_id = input.device().index();

    cudaSetDevice(device_id);

    kmeans_kernel<<<grid_dim, block_dim>>>(input_ptr, x_ptr, centroids_ptr, labels_ptr, output_ptr, initial_centroids_ptr, nums_per_group, num_cluster, max_iter, old_centroids, data_counts);
    cudaDeviceSynchronize();



    cudaFree(old_centroids);
    cudaFree(data_counts);



    return output;
}
