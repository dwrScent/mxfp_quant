 namespace thrust {
namespace cuda_cub {


template <class Generator>
struct generate_f
{
  Generator generator;

  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline))
  generate_f(Generator generator_) : generator(generator_) {}

  template<class T>
  __attribute__((device)) __inline__ __attribute__((always_inline)) void operator()(T const& value)
  {
    T & lvalue = const_cast<T&>(value);
    lvalue = generator();
  }
};


template <class Derived,
          class OutputIt,
          class Size,
          class Generator>
OutputIt __attribute__((host)) __attribute__((device))
generate_n(execution_policy<Derived> &policy,
           OutputIt result,
           Size count,
           Generator generator)
{
  return cuda_cub::for_each_n(policy,
                              result,
                              count,
                              generate_f<Generator>(generator));
}


template <class Derived,
          class OutputIt,
          class Generator>
void __attribute__((host)) __attribute__((device))
generate(execution_policy<Derived> &policy,
         OutputIt first,
         OutputIt last,
         Generator generator)
{
  cuda_cub::generate_n(policy, first, thrust::distance(first, last), generator);
}

}
}
