                if (!(stride == 1)) { ::c10::detail::torchCheckFail( __func__, "/root/miniconda3/envs/awq/lib/python3.10/site-packages/torch/include/torch/csrc/api/include/torch/nn/modules/conv.h", static_cast<uint32_t>(50), (::c10::detail::torchCheckMsgImpl( "Expected " "stride == 1" " to be true, but got false.  " "(Could this error message be improved?  If so, " "please report an enhancement request to PyTorch.)", "padding='same' is not supported for strided convolutions"))); }

