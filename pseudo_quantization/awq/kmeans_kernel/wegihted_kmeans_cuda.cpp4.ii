 namespace cub {


template <bool IS_DESCENDING, typename KeyT>
struct RadixSortTwiddle
{
    typedef Traits<KeyT> TraitsT;
    typedef typename TraitsT::UnsignedBits UnsignedBits;
    static __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) UnsignedBits In(UnsignedBits key)
    {
        key = TraitsT::TwiddleIn(key);
        if (IS_DESCENDING) key = ~key;
        return key;
    }
    static __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) UnsignedBits Out(UnsignedBits key)
    {
        if (IS_DESCENDING) key = ~key;
        key = TraitsT::TwiddleOut(key);
        return key;
    }
    static __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) UnsignedBits DefaultKey()
    {
        return Out(~UnsignedBits(0));
    }
};
