namespace detail {




template <typename T, typename IterT = T*>
struct InputValue
{
    using value_type = T;
    using iterator_type = IterT;
    __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) operator T() {
        if (m_is_future) {
            return m_future_value;
        }
        return m_immediate_value;
    }
    explicit __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) InputValue(T immediate_value): m_is_future(false), m_immediate_value(immediate_value) {}
    explicit __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) InputValue(FutureValue<T, IterT> future_value): m_is_future(true), m_future_value(future_value) {}
    __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) InputValue(const InputValue &other): m_is_future(other.m_is_future) {
        if (m_is_future) {
            m_future_value = other.m_future_value;
        } else {
            m_immediate_value = other.m_immediate_value;
        }
    }

private:
    bool m_is_future;
    union
    {
        FutureValue<T, IterT> m_future_value;
        T m_immediate_value;
    };
};

