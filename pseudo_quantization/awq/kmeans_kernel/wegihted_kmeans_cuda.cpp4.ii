class gil_scoped_acquire {
public:
    inline gil_scoped_acquire() {
        auto &internals = detail::get_internals();
        tstate = (PyThreadState *) PyThread_tss_get((internals.tstate));

        if (!tstate) {





            tstate = PyGILState_GetThisThreadState();
