    __inline__ __attribute__((always_inline)) __attribute__((device)) static void entry(KeysIt1 keys1, KeysIt2 keys2, Size keys1_count, Size keys2_count, Size num_partitions, pair<Size, Size> *partitions, CompareOp compare_op, int items_per_tile, char *)
