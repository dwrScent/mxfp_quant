  template <typename U>
  constexpr complex<T>& operator*=(const complex<U>& rhs) {

    T a = real_;
    T b = imag_;
    U c = rhs.real();
    U d = rhs.imag();
    real_ = a * c - b * d;
    imag_ = a * d + b * c;
