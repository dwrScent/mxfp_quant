  if (!(!name.empty())) { ::c10::detail::torchCheckFail( __func__, "/root/miniconda3/envs/awq/lib/python3.10/site-packages/torch/include/torch/csrc/api/include/torch/nn/module.h", static_cast<uint32_t>(649), (::c10::detail::torchCheckMsgImpl( "Expected " "!name.empty()" " to be true, but got false.  " "(Could this error message be improved?  If so, " "please report an enhancement request to PyTorch.)", "Submodule name must not be empty"))); };
  if (!(name.find('.') == std::string::npos)) { ::c10::detail::torchCheckFail( __func__, "/root/miniconda3/envs/awq/lib/python3.10/site-packages/torch/include/torch/csrc/api/include/torch/nn/module.h", static_cast<uint32_t>(650), (::c10::detail::torchCheckMsgImpl( "Expected " "name.find('.') == std::string::npos" " to be true, but got false.  " "(Could this error message be improved?  If so, " "please report an enhancement request to PyTorch.)", "Submodule name must not contain a dot (got '", name, "')"))); }



