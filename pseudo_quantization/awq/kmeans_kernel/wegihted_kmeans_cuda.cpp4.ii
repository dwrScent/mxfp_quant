  template <
      template <class>
      class Condition,
      class Mapper,
      class... Args,
      size_t... INDEX>
  static guts::array<ResultType, 0> call(
      const Mapper& ,
      std::index_sequence<INDEX...>,
      Args&&... ) {
    return guts::array<ResultType, 0>{};
  }
};
