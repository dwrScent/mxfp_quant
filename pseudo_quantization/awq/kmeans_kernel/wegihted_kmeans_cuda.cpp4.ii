static inline __attribute__((host)) __attribute__((device)) int __occMin(int lhs, int rhs)
{
    return rhs < lhs ? rhs : lhs;
}

static inline __attribute__((host)) __attribute__((device)) int __occDivideRoundUp(int x, int y)
{
    return (x + (y - 1)) / y;
}

static inline __attribute__((host)) __attribute__((device)) int __occRoundUp(int x, int y)
{
    return y * __occDivideRoundUp(x, y);
}
