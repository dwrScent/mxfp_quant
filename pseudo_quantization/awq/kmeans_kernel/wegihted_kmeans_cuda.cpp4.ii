                            thrust::distance(first, last),
                            size_type(0),
                            plus<size_type>());
}

template <class Derived,
          class InputIt,
          class Value>
typename iterator_traits<InputIt>::difference_type __attribute__((host)) __attribute__((device))
count(execution_policy<Derived> &policy,
      InputIt first,
      InputIt last,
      Value const & value)
{
  return cuda_cub::count_if(policy,
                            first,
                            last,
                            thrust::detail::equal_to_value<Value>(value));
}

}
