template <
    typename ChainedPolicyT,
    typename InputIteratorT,
    typename OutputIteratorT,
    typename OffsetT,
    typename ReductionOpT>
__attribute__((launch_bounds(int(ChainedPolicyT::ActivePolicy::ReducePolicy::BLOCK_THREADS))))
__attribute__((global)) void DeviceReduceKernel(
    InputIteratorT d_in,
    OutputIteratorT d_out,
    OffsetT num_items,
    GridEvenShare<OffsetT> even_share,
    ReductionOpT reduction_op)
{

    typedef typename If<(Equals<typename std::iterator_traits<OutputIteratorT>::value_type, void>::VALUE),
        typename std::iterator_traits<InputIteratorT>::value_type,
        typename std::iterator_traits<OutputIteratorT>::value_type>::Type OutputT;


    typedef AgentReduce<
            typename ChainedPolicyT::ActivePolicy::ReducePolicy,
            InputIteratorT,
            OutputIteratorT,
            OffsetT,
            ReductionOpT>
        AgentReduceT;


    __attribute__((shared)) typename AgentReduceT::TempStorage temp_storage;


    OutputT block_aggregate = AgentReduceT(temp_storage, d_in, reduction_op).ConsumeTiles(even_share);


    if (threadIdx.x == 0)
        d_out[blockIdx.x] = block_aggregate;
}





template <
    typename ChainedPolicyT,
    typename InputIteratorT,
    typename OutputIteratorT,
    typename OffsetT,
    typename ReductionOpT,
