inline Tensor mse_loss(
    const Tensor& input,
    const Tensor& target,
    MSELossFuncOptions::reduction_t reduction) {
  if (!(target.sizes() == input.sizes())) {
    ::c10::warn(::c10::Warning( ::c10::UserWarning(), {__func__, "/root/miniconda3/envs/awq/lib/python3.10/site-packages/torch/include/torch/csrc/api/include/torch/nn/functional/loss.h", static_cast<uint32_t>(108)}, ::c10::str("Using a target size (", target.sizes(), ") that is different to the input size (", input.sizes(), "). ", "This will likely lead to incorrect results due to broadcasting. ", "Please ensure they have the same size."), false));;






                                                 ;
  }
  std::vector<torch::Tensor> broadcast_tensors =
      torch::broadcast_tensors({input, target});
  auto expanded_input = broadcast_tensors[0];
  auto expanded_target = broadcast_tensors[1];
  return torch::mse_loss(
      expanded_input, expanded_target, enumtype::reduction_get_enum(reduction));
}
}
